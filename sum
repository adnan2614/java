import java.util.Scanner;
public class loop {
    public static void main(String[] args) {
        System.out.println("Enter a number : ");
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int sum=0;
        for(int i = 0; i<n ; i++)
        {
            sum=sum+i;
        }
        System.out.print(sum+" ");

    }
}
