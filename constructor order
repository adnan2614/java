class Car{
    String brand;
    int speed;
    int year;
    // Constructor
    // Number
    Car()
    {
        brand = "Unknown";
    }
    Car(String b)
    {
        brand = b;
    }
    // Type
    Car(int s)
    {
        speed = s;
    }
    Car(String b, int s)
    {
        brand = b;
        speed = s;
    }
    Car(String b, int s,int y)
    {
        brand = b;
        speed = s;
        year = y;
    }
    // Order
    Car(int s,String b, int y)
    {
        brand = b;
        speed = s;
        year = y;
    }
}
public class Main {
    public static void main(String[] args) {
        Car c1 = new Car();
        c1.brand = "BMW";
        c1.speed = 300;
        c1.year = 2022;
        Car c2 = new Car("Toyota",200,2013);
        Car c3 = new Car("Pagani");
        Car c4 = new Car("Tesla",250);
        Car c5 = new Car(200,"Toyota",2013);
    }
}
