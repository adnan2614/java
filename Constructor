class Car
{
    String brand;
    int speed;
    int year;
    //no argument
    Car()
    {

    }
    //Parameterize
    Car(String b, int s, int y)
    {
        brand =b;
        speed = s;
        year = y;
    }
    // By method
    void initialize(String b, int s, int y)
    {
        brand =b;
        speed = s;
        year = y;
    }
    void display_all()
    {
        System.out.println("Brand : "+brand+"\nSpeed : "+speed+"\nYear : "+year);
    }
}
public class Constructor {
    static void main(String[] args) {
        Car c1 = new Car();
        c1.brand = "Farari";
        c1.year = 200;
        c1.speed = 300;
        System.out.println(c1.brand);
        System.out.println(c1.year);
        System.out.println(c1.speed);
        System.out.println("\n");
        c1.display_all();

        System.out.println("\n");
        //parameterise
        Car c2 = new Car("Pagani",2019,350);
        c2.display_all();

        System.out.println("\n");

        //by method
        Car c3 = new Car();
        c3.initialize("BMW",2020,400);
        c3.display_all();

    }
}
